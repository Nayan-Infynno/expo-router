<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="expo.modules.backgroundrunner" >

    <uses-sdk android:minSdkVersion="24" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <meta-data
            android:name="expo.modules.backgroundrunner.NOTIFICATION_CHANNEL"
            android:value="background_runner_channel" />

        <service
            android:name="expo.modules.backgroundrunner.BackgroundRunnerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            tools:ignore="ForegroundServicePermission" />
        <service
            android:name="expo.modules.backgroundrunner.BackgroundRunnerTaskService"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name="expo.modules.backgroundrunner.BackgroundAlarmReceiver"
            android:enabled="true"
            android:exported="true" />
        <receiver
            android:name="expo.modules.backgroundrunner.BackgroundAutostartReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver" >
            <intent-filter>
                <action android:name="expo.backgroundrunner.RESTART" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>